{
  "name": "edumark-vscode",
  "displayName": "Edumark",
  "description": "Herramienta de edición para Edumark (coloreado, autocompletado y vista previa)",
  "version": "1.0.11",
  "publisher": "gerardfp",
  "repository": {
    "type": "git",
    "url": "https://github.com/gerardfp/edumark"
  },
  "license": "GPL-3.0-or-later",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Snippets"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "edumark",
        "aliases": ["Edumark", "edumark"],
        "extensions": [".edu"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "edumark",
        "scopeName": "source.edu",
        "path": "./syntaxes/edumark.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "edumark",
        "path": "./snippets/snippets.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npx esbuild ./src/extension.ts --bundle --platform=node --target=node18 --external:vscode --outfile=./dist/extension.js",
    "watch": "tsc -watch -p ./"
  },
  "extensionDependencies": [
    "gerardfp.ataula-vscode-extension"
  ],
  "dependencies": {},
  "devDependencies": {
    "@types/vscode": "^1.85.0"
  }
}
