{
  "name": "edumark-vscode",
  "displayName": "Edumark",
  "description": "Herramienta de edición para Edumark (coloreado, autocompletado y vista previa)",
  "version": "1.0.7",
  "publisher": "gerardfp",
  "repository": {
    "type": "git",
    "url": "https://github.com/gerardfp/edumark"
  },
  "license": "GPL-3.0-or-later",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Snippets"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "edumark",
        "aliases": ["Edumark", "edumark"],
        "extensions": [".edu"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "edumark",
        "scopeName": "source.edu",
        "path": "./syntaxes/edumark.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "edumark",
        "path": "./snippets/snippets.json"
      }
    ],
    "commands": [
      {
        "command": "edumark.showPreview",
        "title": "Edumark: Mostrar Vista Previa",
        "category": "Edumark"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "edumark.showPreview",
          "group": "navigation",
          "when": "resourceLangId == edumark"
        }
      ]
    },
    "configuration": {
      "title": "Edumark",
      "properties": {
        "edumark.colors.page": {
          "type": "string",
          "default": "#8bb2f6",
          "description": "Color de resaltado para la directiva @page"
        },
        "edumark.colors.section": {
          "type": "string",
          "default": "#3b82f6",
          "description": "Color de resaltado para la directiva @section"
        },
        "edumark.colors.didyouknow": {
          "type": "string",
          "default": "#8b5cf6",
          "description": "Color de resaltado para la directiva @didyouknow"
        },
        "edumark.colors.warning": {
          "type": "string",
          "default": "#f97316",
          "description": "Color de resaltado para la directiva @warning"
        },
        "edumark.colors.hint": {
          "type": "string",
          "default": "#22c55e",
          "description": "Color de resaltado para la directiva @hint"
        },
        "edumark.colors.solution": {
          "type": "string",
          "default": "#a855f7",
          "description": "Color de resaltado para la directiva @solution"
        },
        "edumark.colors.reflection": {
          "type": "string",
          "default": "#6366f1",
          "description": "Color de resaltado para la directiva @reflection"
        },
        "edumark.colors.activity": {
          "type": "string",
          "default": "#f43f5e",
          "description": "Color de resaltado para la directiva @activity"
        },
        "edumark.colors.note": {
          "type": "string",
          "default": "#64748b",
          "description": "Color de resaltado para la directiva @note"
        },
        "edumark.colors.question": {
          "type": "string",
          "default": "#14b8a6",
          "description": "Color de resaltado para la directiva @question"
        },
        "edumark.colors.rubric": {
          "type": "string",
          "default": "#ec4899",
          "description": "Color de resaltado para la directiva @rubric"
        },
        "edumark.colors.generic": {
          "type": "string",
          "default": "#8e8e8e",
          "description": "Color de resaltado por defecto para directivas arbitrarias o inventadas por el usuario"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npx esbuild ./src/extension.ts --bundle --platform=node --target=node18 --external:vscode --outfile=./dist/extension.js",
    "watch": "tsc -watch -p ./"
  },
  "extensionDependencies": [
    "gerardfp.ataula-vscode-extension"
  ],
  "dependencies": {
    "@edumark/shared": "*",
    "@edumark/parser": "*",
    "@edumark/renderer-html": "*"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0"
  }
}
